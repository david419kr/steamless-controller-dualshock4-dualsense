+func buildCalibrationFeatureReport(reportID uint8, size int) []byte {
+	b := make([]byte, size)
+	b[0] = reportID
+
+	// These values describe a zero-bias, unit-scale IMU. Some DS4-native
+	// clients reject all-zero calibration reports and never expose gyro input.
+	putS16 := func(offset int, value int16) {
+		if offset+1 < len(b) {
+			binary.LittleEndian.PutUint16(b[offset:offset+2], uint16(value))
+		}
+	}
+
+	putS16(1, 0)  // gyro pitch bias
+	putS16(3, 0)  // gyro yaw bias
+	putS16(5, 0)  // gyro roll bias
+	putS16(7, 16) // pitch plus
+	putS16(9, -16)
+	putS16(11, 16) // yaw plus
+	putS16(13, -16)
+	putS16(15, 16) // roll plus
+	putS16(17, -16)
+	putS16(19, 1) // gyro speed plus
+	putS16(21, 1) // gyro speed minus
+	putS16(23, 8192)
+	putS16(25, -8192)
+	putS16(27, 8192)
+	putS16(29, -8192)
+	putS16(31, 8192)
+	putS16(33, -8192)
+	return b
+}
+
+func buildCapabilitiesFeatureReport() []byte {
+	b := make([]byte, 48)
+	b[0] = 0x03
+	b[2] = 0x27
+	b[4] = 0x02 | 0x04 | 0x08 | 0x40 // sensors, lightbar, vibration, touchpad
+	b[5] = 0x00                      // gamepad
+	binary.LittleEndian.PutUint16(b[10:12], 1)
+	binary.LittleEndian.PutUint16(b[12:14], 16)
+	binary.LittleEndian.PutUint16(b[14:16], 1)
+	binary.LittleEndian.PutUint16(b[16:18], 8192)
+	return b
+}
+
+func buildFirmwareFeatureReport() []byte {
+	return []byte{
+		0xA3, 0x41, 0x75, 0x67, 0x20, 0x20, 0x33, 0x20,
+		0x32, 0x30, 0x31, 0x33, 0x00, 0x00, 0x00, 0x00,
+		0x00, 0x30, 0x37, 0x3A, 0x30, 0x31, 0x3A, 0x31,
+		0x32, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+		0x00, 0x00, 0x01, 0x00, 0x31, 0x03, 0x00, 0x00,
+		0x00, 0x49, 0x00, 0x05, 0x00, 0x00, 0x80, 0x03,
+		0x00,
+	}
+}
