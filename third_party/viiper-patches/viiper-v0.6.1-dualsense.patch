new file mode 100644
index 0000000..278b31d
--- /dev/null
+++ b/usb/hid/raw.go
@@ -0,0 +1,13 @@
+package hid
+
+// RawItem injects an already encoded HID descriptor byte stream.
+// It is intended for descriptors copied from hardware traces where the
+// structured item model would be more error-prone than the raw descriptor.
+type RawItem struct {
+	Data Data
+}
+
+func (r RawItem) encode(e *encoder) error {
+	e.buf = append(e.buf, r.Data...)
+	return nil
+}

diff --git a/device/dualsense/const.go b/device/dualsense/const.go
