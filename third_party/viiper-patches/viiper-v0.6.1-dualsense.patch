+package dualsense
+
+import (
+	"encoding/binary"
+	"testing"
+
+	"github.com/Alia5/VIIPER/device"
+	"github.com/Alia5/VIIPER/usbip"
+)
+
+func requireEqual[T comparable](t *testing.T, got, want T, name string) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("%s: got %v, want %v", name, got, want)
+	}
+}
+
+func decodeTouchCoords(b []byte) (uint16, uint16) {
+	x := uint16(b[0]) | (uint16(b[1]&0x0F) << 8)
+	y := (uint16(b[1]) >> 4) | (uint16(b[2]) << 4)
+	return x, y
+}
+
+func TestDescriptorAndFeatureReports(t *testing.T) {
+	vendor := uint16(0x1234)
+	product := uint16(0x5678)
+	dev, err := New(&device.CreateOptions{IdVendor: &vendor, IdProduct: &product})
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	desc := dev.GetDescriptor()
+	requireEqual(t, desc.Device.IDVendor, vendor, "vendor override")
+	requireEqual(t, desc.Device.IDProduct, product, "product override")
+	requireEqual(t, desc.Strings[1], "Sony Interactive Entertainment", "manufacturer string")
+	requireEqual(t, desc.Strings[2], "Wireless Controller", "product string")
+	requireEqual(t, desc.Interfaces[0].Descriptor.BInterfaceClass, uint8(0x03), "hid interface class")
+	requireEqual(t, desc.Interfaces[0].Endpoints[0].BEndpointAddress, uint8(EndpointIn), "input endpoint")
+	requireEqual(t, desc.Interfaces[0].Endpoints[1].BEndpointAddress, uint8(EndpointOut), "output endpoint")
+
+	report, err := desc.Interfaces[0].HID.ReportBytes()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(report) == 0 {
+		t.Fatal("empty report descriptor")
+	}
+
+	for _, tc := range []struct {
+		name    string
+		wValue  uint16
+		wLength uint16
+		wantID  byte
+	}{
+		{"capabilities", 0x0303, 48, 0x03},
+		{"calibration", 0x0305, 41, 0x05},
+		{"pairing", 0x0309, 16, 0x09},
+		{"firmware", 0x0320, 64, 0x20},
+	} {
+		resp, handled := dev.HandleControl(0xA1, 0x01, tc.wValue, 0, tc.wLength, nil)
+		if !handled {
+			t.Fatalf("%s: feature report was not handled", tc.name)
+		}
+		requireEqual(t, len(resp), int(tc.wLength), tc.name+" length")
+		requireEqual(t, resp[0], tc.wantID, tc.name+" report id")
+	}
+}
+
+func TestInputStateWireRoundTrip(t *testing.T) {
+	in := InputState{
+		LX:                  1,
+		LY:                  2,
+		RX:                  3,
+		RY:                  4,
+		L2:                  5,
+		R2:                  6,
+		DPad:                DPadUp | DPadLeft,
+		Buttons:             ButtonCross | ButtonPS | ButtonTouchpadClick,
+		Touch1X:             100,
+		Touch1Y:             200,
+		Touch1Active:        true,
+		Touch2X:             300,
+		Touch2Y:             400,
+		Touch2Active:        true,
+		GyroX:               -1,
+		GyroY:               -2,
+		GyroZ:               3,
+		AccelX:              4,
+		AccelY:              -5,
+		AccelZ:              6,
+		BatteryLevelPercent: 87,
+		ChargeState:         4,
+	}
+
+	data, err := in.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireEqual(t, len(data), 33, "input wire size")
+
+	var out InputState
+	if err := out.UnmarshalBinary(data); err != nil {
+		t.Fatal(err)
+	}
+	requireEqual(t, out, in, "input round trip")
+}
+
+func TestInputReport(t *testing.T) {
+	dev, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	dev.UpdateInputState(&InputState{
+		LX:                  0x11,
+		LY:                  0x22,
+		RX:                  0x33,
+		RY:                  0x44,
+		L2:                  0x55,
+		R2:                  0x66,
+		DPad:                DPadUp | DPadRight,
+		Buttons:             ButtonCross | ButtonCircle | ButtonL1 | ButtonR2 | ButtonOptions | ButtonPS | ButtonTouchpadClick | ButtonMute,
+		Touch1X:             1000,
+		Touch1Y:             500,
+		Touch1Active:        true,
+		Touch2X:             0,
+		Touch2Y:             0,
+		Touch2Active:        false,
+		GyroX:               -1234,
+		GyroY:               2345,
+		GyroZ:               -3456,
+		AccelX:              4567,
+		AccelY:              -5678,
+		AccelZ:              6789,
+		BatteryLevelPercent: 87,
+		ChargeState:         4,
+	})
+
+	report := dev.HandleTransfer(4, usbip.DirIn, nil)
+	requireEqual(t, len(report), InputReportSize, "input report size")
+	requireEqual(t, report[0], byte(ReportIDInput), "input report id")
+	requireEqual(t, report[1], byte(0x11), "left stick x")
+	requireEqual(t, report[6], byte(0x66), "right trigger")
+	requireEqual(t, report[8], byte(0x61), "dpad and face buttons")
+	requireEqual(t, report[9], byte(0x29), "shoulder buttons")
+	requireEqual(t, report[10], byte(0x07), "system buttons")
+	requireEqual(t, binary.LittleEndian.Uint32(report[12:16]), uint32(1), "packet sequence")
+	requireEqual(t, int16(binary.LittleEndian.Uint16(report[16:18])), int16(-1234), "gyro x")
+	requireEqual(t, int16(binary.LittleEndian.Uint16(report[26:28])), int16(6789), "accel z")
+	requireEqual(t, binary.LittleEndian.Uint32(report[28:32]), uint32(12000), "sensor timestamp")
+
+	requireEqual(t, report[33], byte(1), "touch1 tracking")
+	x, y := decodeTouchCoords(report[34:37])
+	requireEqual(t, x, uint16(1000), "touch1 x")
+	requireEqual(t, y, uint16(500), "touch1 y")
+	requireEqual(t, report[37]&TouchInactiveMask, TouchInactiveMask, "touch2 inactive")
+	requireEqual(t, binary.LittleEndian.Uint32(report[49:53]), uint32(12000), "secondary timestamp")
+	requireEqual(t, report[53], byte(0x28), "battery byte")
+	requireEqual(t, report[54], byte(DS5ConnectionStateUSB), "usb connection state")
+}
+
+func TestOutputFeedback(t *testing.T) {
+	report := make([]byte, OutputReportSize)
+	report[0] = ReportIDOutput
+	report[1] = 0x03
+	report[2] = 0x04
+	report[3] = 0x21
+	report[4] = 0xDC
+	report[11] = 0xAA
+	report[21] = 0xBB
+	report[22] = 0xCC
+	report[32] = 0xDD
+	report[39] = 0x40
+
+	feedback, ok := parseOutputReport(report)
+	if !ok {
+		t.Fatal("output report was not parsed")
+	}
+	requireEqual(t, feedback.EnableBits1, uint8(0x03), "enable bits 1")
+	requireEqual(t, feedback.EnableBits2, uint8(0x04), "enable bits 2")
+	requireEqual(t, feedback.RumbleRight, uint8(0x21), "right rumble")
+	requireEqual(t, feedback.RumbleLeft, uint8(0xDC), "left rumble")
+	requireEqual(t, feedback.RightTriggerEffect[0], uint8(0xAA), "right trigger first byte")
+	requireEqual(t, feedback.RightTriggerEffect[10], uint8(0xBB), "right trigger last byte")
+	requireEqual(t, feedback.LeftTriggerEffect[0], uint8(0xCC), "left trigger first byte")
+	requireEqual(t, feedback.LeftTriggerEffect[10], uint8(0xDD), "left trigger last byte")
+	requireEqual(t, feedback.EnableBits3, uint8(0x40), "enable bits 3")
+
+	data, err := feedback.MarshalBinary()
+	if err != nil {
+		t.Fatal(err)
+	}
+	requireEqual(t, len(data), 27, "feedback wire size")
+
+	var roundTrip OutputState
+	if err := roundTrip.UnmarshalBinary(data); err != nil {
+		t.Fatal(err)
+	}
+	requireEqual(t, roundTrip, feedback, "feedback round trip")
+}
+
+func TestOutputCallback(t *testing.T) {
+	dev, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	var got OutputState
+	called := false
+	dev.SetOutputCallback(func(feedback OutputState) {
+		got = feedback
+		called = true
+	})
+
+	report := make([]byte, OutputReportSize)
+	report[0] = ReportIDOutput
+	report[3] = 0x44
+	report[4] = 0x55
+	dev.HandleTransfer(3, usbip.DirOut, report)
+
+	if !called {
+		t.Fatal("output callback was not called")
+	}
+	requireEqual(t, got.RumbleRight, uint8(0x44), "callback right rumble")
+	requireEqual(t, got.RumbleLeft, uint8(0x55), "callback left rumble")
+}
