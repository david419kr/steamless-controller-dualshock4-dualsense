+package dualsense
+
+const (
+	DefaultVID = 0x054C
+	DefaultPID = 0x0CE6
+)
+
+const (
+	EndpointIn  = 0x84
+	EndpointOut = 0x03
+)
+
+const (
+	ReportIDInput  = 0x01
+	ReportIDOutput = 0x02
+)
+
+const (
+	InputReportSize  = 64
+	OutputReportSize = 48
+)
+
+const (
+	ButtonPS            uint16 = 0x0001
+	ButtonTouchpadClick uint16 = 0x0002
+	ButtonMute          uint16 = 0x0004
+	ButtonSquare        uint16 = 0x0010
+	ButtonCross         uint16 = 0x0020
+	ButtonCircle        uint16 = 0x0040
+	ButtonTriangle      uint16 = 0x0080
+	ButtonL1            uint16 = 0x0100
+	ButtonR1            uint16 = 0x0200
+	ButtonL2            uint16 = 0x0400
+	ButtonR2            uint16 = 0x0800
+	ButtonCreate        uint16 = 0x1000
+	ButtonOptions       uint16 = 0x2000
+	ButtonL3            uint16 = 0x4000
+	ButtonR3            uint16 = 0x8000
+)
+
+const (
+	DPadUp    = 0x01
+	DPadDown  = 0x02
+	DPadLeft  = 0x04
+	DPadRight = 0x08
+)
+
+const (
+	DPadUSBUp        = 0x00
+	DPadUSBUpRight   = 0x01
+	DPadUSBRight     = 0x02
+	DPadUSBDownRight = 0x03
+	DPadUSBDown      = 0x04
+	DPadUSBDownLeft  = 0x05
+	DPadUSBLeft      = 0x06
+	DPadUSBUpLeft    = 0x07
+	DPadUSBNeutral   = 0x08
+)
+
+const (
+	TouchInactiveMask uint8  = 0x80
+	TouchpadMaxX      uint16 = 1919
+	TouchpadMaxY      uint16 = 1069
+)
+
+const (
+	DS5EnableRumbleEmulation  = 0x01
+	DS5DisableAudioHaptics    = 0x02
+	DS5EnableImprovedRumble   = 0x04
+	DS5ConnectionStateUSB     = 0x08
+	DS5BatteryStatusDischarge = 0x00
+	DS5BatteryStatusCharging  = 0x01
+	DS5BatteryStatusFull      = 0x02
+)

diff --git a/device/dualsense/inputstate.go b/device/dualsense/inputstate.go
new file mode 100644
index 0000000..da4f34b
--- /dev/null
+++ b/device/dualsense/inputstate.go
@@ -0,0 +1,123 @@
+package dualsense
+
+import (
+	"encoding/binary"
+	"io"
+)
+
+// viiper:wire dualsense c2s stickLX:u8 stickLY:u8 stickRX:u8 stickRY:u8 triggerL2:u8 triggerR2:u8 dpad:u8 buttons:u16 touch1X:u16 touch1Y:u16 touch1Active:bool touch2X:u16 touch2Y:u16 touch2Active:bool gyroX:i16 gyroY:i16 gyroZ:i16 accelX:i16 accelY:i16 accelZ:i16 batteryLevelPercent:u8 chargeState:u8
+type InputState struct {
+	LX, LY uint8
+	RX, RY uint8
+	L2, R2 uint8
+	DPad   uint8
+
+	Buttons uint16
+
+	Touch1X, Touch1Y uint16
+	Touch1Active     bool
+	Touch2X, Touch2Y uint16
+	Touch2Active     bool
+
+	GyroX, GyroY, GyroZ    int16
+	AccelX, AccelY, AccelZ int16
+	BatteryLevelPercent    uint8
+	ChargeState            uint8
+}
+
+func (s *InputState) MarshalBinary() ([]byte, error) {
+	b := make([]byte, 33)
+	b[0] = s.LX
+	b[1] = s.LY
+	b[2] = s.RX
+	b[3] = s.RY
+	b[4] = s.L2
+	b[5] = s.R2
+	b[6] = s.DPad
+	binary.LittleEndian.PutUint16(b[7:9], s.Buttons)
+	binary.LittleEndian.PutUint16(b[9:11], s.Touch1X)
+	binary.LittleEndian.PutUint16(b[11:13], s.Touch1Y)
+	if s.Touch1Active {
+		b[13] = 1
+	}
+	binary.LittleEndian.PutUint16(b[14:16], s.Touch2X)
+	binary.LittleEndian.PutUint16(b[16:18], s.Touch2Y)
+	if s.Touch2Active {
+		b[18] = 1
+	}
+	binary.LittleEndian.PutUint16(b[19:21], uint16(s.GyroX))
+	binary.LittleEndian.PutUint16(b[21:23], uint16(s.GyroY))
+	binary.LittleEndian.PutUint16(b[23:25], uint16(s.GyroZ))
+	binary.LittleEndian.PutUint16(b[25:27], uint16(s.AccelX))
+	binary.LittleEndian.PutUint16(b[27:29], uint16(s.AccelY))
+	binary.LittleEndian.PutUint16(b[29:31], uint16(s.AccelZ))
+	b[31] = s.BatteryLevelPercent
+	b[32] = s.ChargeState
+	return b, nil
+}
+
+func (s *InputState) UnmarshalBinary(data []byte) error {
+	if len(data) < 33 {
+		return io.ErrUnexpectedEOF
+	}
+	s.LX = data[0]
+	s.LY = data[1]
+	s.RX = data[2]
+	s.RY = data[3]
+	s.L2 = data[4]
+	s.R2 = data[5]
+	s.DPad = data[6]
+	s.Buttons = binary.LittleEndian.Uint16(data[7:9])
+	s.Touch1X = binary.LittleEndian.Uint16(data[9:11])
+	s.Touch1Y = binary.LittleEndian.Uint16(data[11:13])
+	s.Touch1Active = data[13] != 0
+	s.Touch2X = binary.LittleEndian.Uint16(data[14:16])
+	s.Touch2Y = binary.LittleEndian.Uint16(data[16:18])
+	s.Touch2Active = data[18] != 0
+	s.GyroX = int16(binary.LittleEndian.Uint16(data[19:21]))
+	s.GyroY = int16(binary.LittleEndian.Uint16(data[21:23]))
+	s.GyroZ = int16(binary.LittleEndian.Uint16(data[23:25]))
+	s.AccelX = int16(binary.LittleEndian.Uint16(data[25:27]))
+	s.AccelY = int16(binary.LittleEndian.Uint16(data[27:29]))
+	s.AccelZ = int16(binary.LittleEndian.Uint16(data[29:31]))
+	s.BatteryLevelPercent = data[31]
+	s.ChargeState = data[32]
+	return nil
+}
+
+// viiper:wire dualsense s2c enableBits1:u8 enableBits2:u8 rumbleRight:u8 rumbleLeft:u8 enableBits3:u8 rightTriggerEffect:u8*11 leftTriggerEffect:u8*11
+type OutputState struct {
+	EnableBits1        uint8
+	EnableBits2        uint8
+	RumbleRight        uint8
+	RumbleLeft         uint8
+	EnableBits3        uint8
+	RightTriggerEffect [11]uint8
+	LeftTriggerEffect  [11]uint8
+}
+
+func (f *OutputState) MarshalBinary() ([]byte, error) {
+	b := make([]byte, 27)
+	b[0] = f.EnableBits1
+	b[1] = f.EnableBits2
+	b[2] = f.RumbleRight
+	b[3] = f.RumbleLeft
+	b[4] = f.EnableBits3
+	copy(b[5:16], f.RightTriggerEffect[:])
+	copy(b[16:27], f.LeftTriggerEffect[:])
+	return b, nil
+}
+
+func (f *OutputState) UnmarshalBinary(data []byte) error {
+	if len(data) < 27 {
+		return io.ErrUnexpectedEOF
+	}
+	f.EnableBits1 = data[0]
+	f.EnableBits2 = data[1]
+	f.RumbleRight = data[2]
+	f.RumbleLeft = data[3]
+	f.EnableBits3 = data[4]
+	copy(f.RightTriggerEffect[:], data[5:16])
+	copy(f.LeftTriggerEffect[:], data[16:27])
+	return nil
+}

diff --git a/device/dualsense/handler.go b/device/dualsense/handler.go
new file mode 100644
index 0000000..e6669da
--- /dev/null
+++ b/device/dualsense/handler.go
@@ -0,0 +1,60 @@
+package dualsense
+
+import (
+	"fmt"
+	"io"
+	"log/slog"
+	"net"
+
+	"github.com/Alia5/VIIPER/device"
+	"github.com/Alia5/VIIPER/internal/server/api"
+	"github.com/Alia5/VIIPER/usb"
+)
+
+func init() {
+	api.RegisterDevice("dualsense", &handler{})
+}
+
+type handler struct{}
+
+func (h *handler) CreateDevice(o *device.CreateOptions) (usb.Device, error) { return New(o) }
+
+func (h *handler) StreamHandler() api.StreamHandlerFunc {
+	return func(conn net.Conn, devPtr *usb.Device, logger *slog.Logger) error {
+		if devPtr == nil || *devPtr == nil {
+			return fmt.Errorf("nil device")
+		}
+		ds, ok := (*devPtr).(*DualSense)
+		if !ok {
+			return fmt.Errorf("device is not dualsense")
+		}
+
+		ds.SetOutputCallback(func(feedback OutputState) {
+			data, err := feedback.MarshalBinary()
+			if err != nil {
+				logger.Error("failed to marshal feedback", "error", err)
+				return
+			}
+			if _, err := conn.Write(data); err != nil {
+				logger.Error("failed to send feedback", "error", err)
+			}
+		})
+
+		buf := make([]byte, 33)
+		for {
+			if _, err := io.ReadFull(conn, buf); err != nil {
+				if err == io.EOF {
+					logger.Info("client disconnected")
+					return nil
+				}
+				return fmt.Errorf("read input state: %w", err)
+			}
+
+			var state InputState
+			if err := state.UnmarshalBinary(buf); err != nil {
+				return fmt.Errorf("unmarshal input state: %w", err)
+			}
+			ds.UpdateInputState(&state)
+		}
+	}
+}

diff --git a/device/dualsense/device.go b/device/dualsense/device.go
new file mode 100644
index 0000000..7766a3d
--- /dev/null
+++ b/device/dualsense/device.go
@@ -0,0 +1,511 @@
+package dualsense
+
+import (
+	"encoding/binary"
+	"log/slog"
+	"sync"
+
+	"github.com/Alia5/VIIPER/device"
+	"github.com/Alia5/VIIPER/usb"
+	"github.com/Alia5/VIIPER/usb/hid"
+	"github.com/Alia5/VIIPER/usbip"
+)
+
+type DualSense struct {
+	inputState *InputState
+	stateMu    sync.Mutex
+	outputFunc func(OutputState)
+	descriptor usb.Descriptor
+
+	reportCounter   uint8
+	packetSequence  uint32
+	sensorTimestamp uint32
+	touch1Tracking  uint8
+	touch2Tracking  uint8
+	touch1WasActive bool
+	touch2WasActive bool
+}
+
+type inputReportState struct {
+	input           InputState
+	reportCounter   uint8
+	packetSequence  uint32
+	sensorTimestamp uint32
+	touch1Tracking  uint8
+	touch2Tracking  uint8
+}
+
+func New(o *device.CreateOptions) (*DualSense, error) {
+	d := &DualSense{
+		descriptor: defaultDescriptor,
+	}
+	if o != nil {
+		if o.IdVendor != nil {
+			d.descriptor.Device.IDVendor = *o.IdVendor
+		}
+		if o.IdProduct != nil {
+			d.descriptor.Device.IDProduct = *o.IdProduct
+		}
+	}
+
+	d.inputState = &InputState{
+		LX:                  0x80,
+		LY:                  0x80,
+		RX:                  0x80,
+		RY:                  0x80,
+		BatteryLevelPercent: 100,
+		ChargeState:         DS5BatteryStatusFull,
+	}
+
+	return d, nil
+}
+
+func (d *DualSense) SetOutputCallback(f func(OutputState)) {
+	d.outputFunc = f
+}
+
+func (d *DualSense) UpdateInputState(state *InputState) {
+	d.stateMu.Lock()
+	defer d.stateMu.Unlock()
+
+	if state.Touch1Active && !d.touch1WasActive {
+		d.touch1Tracking = (d.touch1Tracking + 1) & 0x7F
+	}
+	if state.Touch2Active && !d.touch2WasActive {
+		d.touch2Tracking = (d.touch2Tracking + 1) & 0x7F
+	}
+	d.touch1WasActive = state.Touch1Active
+	d.touch2WasActive = state.Touch2Active
+	d.reportCounter++
+	d.packetSequence++
+	d.sensorTimestamp += 12000
+	st := *state
+	d.inputState = &st
+}
+
+func (d *DualSense) inputReportState() inputReportState {
+	d.stateMu.Lock()
+	defer d.stateMu.Unlock()
+	return inputReportState{
+		input:           *d.inputState,
+		reportCounter:   d.reportCounter,
+		packetSequence:  d.packetSequence,
+		sensorTimestamp: d.sensorTimestamp,
+		touch1Tracking:  d.touch1Tracking,
+		touch2Tracking:  d.touch2Tracking,
+	}
+}
+
+func (d *DualSense) HandleTransfer(ep uint32, dir uint32, out []byte) []byte {
+	if dir == usbip.DirIn {
+		switch ep {
+		case 4:
+			return d.buildUSBInputReport(d.inputReportState())
+		default:
+			return nil
+		}
+	}
+
+	if dir == usbip.DirOut && ep == 3 {
+		if feedback, ok := parseOutputReport(out); ok && d.outputFunc != nil {
+			d.outputFunc(feedback)
+		}
+	}
+
+	return nil
+}
+
+func (d *DualSense) HandleControl(bmRequestType, bRequest uint8, wValue, _ /* wIndex */, wLength uint16, data []byte) ([]byte, bool) {
+	const (
+		hidGetReport = 0x01
+		hidSetReport = 0x09
+	)
+	const (
+		reportTypeInput   = 0x01
+		reportTypeOutput  = 0x02
+		reportTypeFeature = 0x03
+	)
+
+	reportType := uint8(wValue >> 8)
+	reportID := uint8(wValue & 0xFF)
+
+	if bmRequestType == 0xA1 && bRequest == hidGetReport {
+		if reportType == reportTypeInput && reportID == ReportIDInput {
+			report := d.buildUSBInputReport(d.inputReportState())
+			if wLength > 0 && int(wLength) < len(report) {
+				return report[:wLength], true
+			}
+			return report, true
+		}
+
+		if reportType == reportTypeFeature {
+			switch reportID {
+			case 0x03:
+				return buildCapabilitiesFeatureReport(), true
+			case 0x05:
+				return buildCalibrationFeatureReport(), true
+			case 0x09:
+				return []byte{0x09, 0xC0, 0x13, 0x37, 0x05, 0x02, 0x06, 0x09, 0x25, 0x00, 0, 0, 0, 0, 0, 0}, true
+			case 0x20:
+				return buildFirmwareFeatureReport(), true
+			}
+		}
+	}
+
+	if bmRequestType == 0x21 && bRequest == hidSetReport {
+		if reportType == reportTypeOutput && reportID == ReportIDOutput {
+			if feedback, ok := parseOutputReport(data); ok {
+				if d.outputFunc != nil {
+					d.outputFunc(feedback)
+				}
+				return nil, true
+			}
+		}
+	}
+
+	slog.Warn("Unsupported DualSense control request",
+		"bmRequestType", bmRequestType,
+		"bRequest", bRequest,
+		"reportType", reportType,
+		"reportID", reportID)
+
+	return nil, false
+}
+
+func parseOutputReport(data []byte) (OutputState, bool) {
+	if len(data) >= OutputReportSize && data[0] == ReportIDOutput {
+		data = data[1:]
+	}
+	if len(data) < 47 {
+		return OutputState{}, false
+	}
+
+	var feedback OutputState
+	feedback.EnableBits1 = data[0]
+	feedback.EnableBits2 = data[1]
+	feedback.RumbleRight = data[2]
+	feedback.RumbleLeft = data[3]
+	copy(feedback.RightTriggerEffect[:], data[10:21])
+	copy(feedback.LeftTriggerEffect[:], data[21:32])
+	feedback.EnableBits3 = data[38]
+	return feedback, true
+}
+
+func (d *DualSense) GetDescriptor() *usb.Descriptor {
+	return &d.descriptor
+}
+
+func (d *DualSense) GetDeviceSpecificArgs() map[string]any {
+	return map[string]any{}
+}
+
+func (d *DualSense) buildUSBInputReport(snapshot inputReportState) []byte {
+	s := snapshot.input
+	b := make([]byte, InputReportSize)
+	b[0] = ReportIDInput
+	b[1] = s.LX
+	b[2] = s.LY
+	b[3] = s.RX
+	b[4] = s.RY
+	b[5] = s.L2
+	b[6] = s.R2
+	b[7] = snapshot.reportCounter
+
+	b[8] = dpadToHat(s.DPad) | faceButtonsNibble(s.Buttons)
+	b[9] = shoulderButtonsByte(s.Buttons)
+	b[10] = systemButtonsByte(s.Buttons)
+	b[11] = 0
+
+	binary.LittleEndian.PutUint32(b[12:16], snapshot.packetSequence)
+	binary.LittleEndian.PutUint16(b[16:18], uint16(s.GyroX))
+	binary.LittleEndian.PutUint16(b[18:20], uint16(s.GyroY))
+	binary.LittleEndian.PutUint16(b[20:22], uint16(s.GyroZ))
+	binary.LittleEndian.PutUint16(b[22:24], uint16(s.AccelX))
+	binary.LittleEndian.PutUint16(b[24:26], uint16(s.AccelY))
+	binary.LittleEndian.PutUint16(b[26:28], uint16(s.AccelZ))
+	binary.LittleEndian.PutUint32(b[28:32], snapshot.sensorTimestamp)
+	b[32] = 0
+
+	touch1Counter := snapshot.touch1Tracking & 0x7F
+	if !s.Touch1Active {
+		touch1Counter |= TouchInactiveMask
+	}
+	b[33] = touch1Counter
+	encodeTouchCoords(b[34:37], s.Touch1X, s.Touch1Y)
+
+	touch2Counter := snapshot.touch2Tracking & 0x7F
+	if !s.Touch2Active {
+		touch2Counter |= TouchInactiveMask
+	}
+	b[37] = touch2Counter
+	encodeTouchCoords(b[38:41], s.Touch2X, s.Touch2Y)
+
+	binary.LittleEndian.PutUint32(b[49:53], snapshot.sensorTimestamp)
+	b[53] = batteryByte(s.BatteryLevelPercent, s.ChargeState)
+	b[54] = DS5ConnectionStateUSB
+	return b
+}
+
+func dpadToHat(dpad uint8) uint8 {
+	if dpad&DPadUp != 0 && dpad&DPadRight != 0 {
+		return DPadUSBUpRight
+	}
+	if dpad&DPadUp != 0 && dpad&DPadLeft != 0 {
+		return DPadUSBUpLeft
+	}
+	if dpad&DPadDown != 0 && dpad&DPadRight != 0 {
+		return DPadUSBDownRight
+	}
+	if dpad&DPadDown != 0 && dpad&DPadLeft != 0 {
+		return DPadUSBDownLeft
+	}
+	if dpad&DPadUp != 0 {
+		return DPadUSBUp
+	}
+	if dpad&DPadDown != 0 {
+		return DPadUSBDown
+	}
+	if dpad&DPadLeft != 0 {
+		return DPadUSBLeft
+	}
+	if dpad&DPadRight != 0 {
+		return DPadUSBRight
+	}
+	return DPadUSBNeutral
+}
+
+func faceButtonsNibble(buttons uint16) uint8 {
+	var face uint8
+	if buttons&ButtonSquare != 0 {
+		face |= 0x01
+	}
+	if buttons&ButtonCross != 0 {
+		face |= 0x02
+	}
+	if buttons&ButtonCircle != 0 {
+		face |= 0x04
+	}
+	if buttons&ButtonTriangle != 0 {
+		face |= 0x08
+	}
+	return face << 4
+}
+
+func shoulderButtonsByte(buttons uint16) uint8 {
+	var out uint8
+	if buttons&ButtonL1 != 0 {
+		out |= 0x01
+	}
+	if buttons&ButtonR1 != 0 {
+		out |= 0x02
+	}
+	if buttons&ButtonL2 != 0 {
+		out |= 0x04
+	}
+	if buttons&ButtonR2 != 0 {
+		out |= 0x08
+	}
+	if buttons&ButtonCreate != 0 {
+		out |= 0x10
+	}
+	if buttons&ButtonOptions != 0 {
+		out |= 0x20
+	}
+	if buttons&ButtonL3 != 0 {
+		out |= 0x40
+	}
+	if buttons&ButtonR3 != 0 {
+		out |= 0x80
+	}
+	return out
+}
+
+func systemButtonsByte(buttons uint16) uint8 {
+	var out uint8
+	if buttons&ButtonPS != 0 {
+		out |= 0x01
+	}
+	if buttons&ButtonTouchpadClick != 0 {
+		out |= 0x02
+	}
+	if buttons&ButtonMute != 0 {
+		out |= 0x04
+	}
+	return out
+}
+
+func encodeTouchCoords(b []byte, x, y uint16) {
+	if x > TouchpadMaxX {
+		x = TouchpadMaxX
+	}
+	if y > TouchpadMaxY {
+		y = TouchpadMaxY
+	}
+
+	b[0] = uint8(x & 0xFF)
+	b[1] = uint8((x>>8)&0x0F) | uint8((y&0x0F)<<4)
+	b[2] = uint8(y >> 4)
+}
+
+func batteryByte(levelPercent, chargeState uint8) uint8 {
+	level := levelPercent / 10
+	if level > 10 {
+		level = 10
+	}
+
+	status := uint8(DS5BatteryStatusDischarge)
+	switch chargeState {
+	case 2:
+		status = DS5BatteryStatusCharging
+	case 4:
+		status = DS5BatteryStatusFull
+	}
+	return (status << 4) | (level & 0x0F)
+}
+
+func buildCalibrationFeatureReport() []byte {
+	b := make([]byte, 41)
+	b[0] = 0x05
+	putS16 := func(offset int, value int16) {
+		binary.LittleEndian.PutUint16(b[offset:offset+2], uint16(value))
+	}
+	putS16(1, 0)
+	putS16(3, 0)
+	putS16(5, 0)
+	putS16(7, 1024)
+	putS16(9, -1024)
+	putS16(11, 1024)
+	putS16(13, -1024)
+	putS16(15, 1024)
+	putS16(17, -1024)
+	putS16(19, 64)
+	putS16(21, 64)
+	putS16(23, 8192)
+	putS16(25, -8192)
+	putS16(27, 8192)
+	putS16(29, -8192)
+	putS16(31, 8192)
+	putS16(33, -8192)
+	return b
+}
+
+func buildCapabilitiesFeatureReport() []byte {
+	b := make([]byte, 48)
+	b[0] = 0x03
+	b[2] = 0x28
+	b[4] = 0x02 | 0x04 | 0x08 | 0x40
+	b[5] = 0x00
+	b[20] = 0x80 | 0x01
+	return b
+}
+
+func buildFirmwareFeatureReport() []byte {
